{
  "manifest_version": 3,
  "name": "Recall — DSA Tracker",
  "version": "0.3.0",
  "description": "Offer a practice reminder after a newly accepted LeetCode submission, then review and save in Recall.",
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recall DSA Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "src/adapters/leetcode.js",
        "src/capture.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
