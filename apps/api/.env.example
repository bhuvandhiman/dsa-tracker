HOST=127.0.0.1
PORT=3001
# Required for Phase 2 data routes. Health and the dashboard shell can run without it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsa_tracker

# Keep local mode for the existing single-user workspace.
# Change to supabase to require verified sessions and separate user workspaces.
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Direct HTTPS video URL; leave blank until the installation video is ready.
EXTENSION_VIDEO_URL=
# Leave blank for ZIP + Load unpacked; later set the Chrome Web Store listing URL.
EXTENSION_STORE_URL=
# Optional server-only key enables account deletion. Never use VITE_ for this key.
SUPABASE_SECRET_KEY=
# Local remains the default. Hosted mode requires verified accounts and HTTPS.
DEPLOYMENT_MODE=local
APP_ORIGIN=
# Download the database root certificate from Supabase if the pooler requires it.
DATABASE_CA_CERT=
