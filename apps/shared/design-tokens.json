      "fast": "120ms",
      "normal": "180ms",
      "slow": "250ms",
      "slower": "350ms"
    },
    "easing": {
      "linear": "linear",
      "ease": "ease",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "transition": {
      "color": "color var(--motion-duration-fast) var(--motion-easing-easeOut)",
      "background": "background-color var(--motion-duration-normal) var(--motion-easing-easeOut)",
      "border": "border-color var(--motion-duration-fast) var(--motion-easing-easeOut)",
      "transform": "transform var(--motion-duration-normal) var(--motion-easing-easeOut)",
      "opacity": "opacity var(--motion-duration-fast) var(--motion-easing-easeOut)",
      "width": "width var(--motion-duration-normal) var(--motion-easing-easeOut)",
      "height": "height var(--motion-duration-normal) var(--motion-easing-easeOut)",
      "all": "all var(--motion-duration-normal) var(--motion-easing-easeOut)"
    }
