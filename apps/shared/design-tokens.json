      "medium": { "bg": "var(--mustard)", "color": "#202720", "border": "currentColor" },
      "lower": { "bg": "var(--track)", "color": "var(--accent-ink)", "border": "currentColor" }
    },
    "status": {
      "good": { "color": "var(--accent-ink)" },
      "warning": { "color": "var(--nav-ink)", "bg": "var(--coral-soft)" },
      "error": { "color": "var(--nav-ink)", "border": "var(--coral)" }
    },
    "shadow": {
      "dialog": { "light": "0 18px 60px #0003", "dark": "0 18px 60px #0003", "description": "Modal/dialog shadow" },
