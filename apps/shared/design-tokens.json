{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Recall Design Tokens - Single source of truth for colors, spacing, typography, shadows, radii, and motion",
  "color": {
    "core": {
      "canvas": { "light": "#fafbe9", "dark": "#181f1c", "description": "Page background" },
      "ink": { "light": "#202720", "dark": "#f3f2df", "description": "Primary text color" },
      "muted": { "light": "#606756", "dark": "#b9c2b5", "description": "Secondary/de-emphasized text" }
    },
    "brand": {
