      "mustard": { "light": "#f2b632", "dark": "#f2b632", "description": "Secondary brand color - medium emphasis, recent practice" },
      "teal": { "light": "#2c8075", "dark": "#2c8075", "description": "Tertiary brand color - lower emphasis, retention, success" }
    },
    "semantic": {
      "onAccent": { "light": "#fffdec", "dark": "#fffdec", "description": "Text on brand colors" },
      "accentInk": { "light": "#24695f", "dark": "#8bd4c5", "description": "Accent text on brand backgrounds" },
      "track": { "light": "#d8deca", "dark": "#48574b", "description": "Track/background for progress bars, sliders" },
