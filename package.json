{
  "name": "dsa-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "npm run dev --workspace=@dsa/web",
    "dev:api": "npm run dev --workspace=@dsa/api",
    "build": "npm run build --workspace=@dsa/web",
    "start:api": "npm run start --workspace=@dsa/api",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:capture": "node scripts/test-capture.js",
    "check": "npm run lint && npm test && npm run build",
    "db:check": "npm run db:check --workspace=@dsa/api",
    "db:migrate": "npm run db:migrate --workspace=@dsa/api",
    "test:db": "node --env-file-if-exists=apps/api/.env --test tests/database.integration.js tests/journal.integration.js tests/legacy.integration.js tests/retention.integration.js tests/strength.integration.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  }
}
